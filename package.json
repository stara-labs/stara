{
  "name": "stara",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "24.16.0",
    "pnpm": "11.19.0"
  },
  "scripts": {
    "bootstrap": "node tooling/scripts/workspace.mjs bootstrap",
    "start": "node tooling/scripts/workspace.mjs start",
    "dev": "node tooling/scripts/workspace.mjs dev",
    "environment:down": "node tooling/scripts/workspace.mjs down",
    "environment:logs": "node tooling/scripts/workspace.mjs logs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0 && node tooling/scripts/workspace.mjs layout",
    "typecheck": "pnpm -r --filter @stara/web --filter @stara/ui --filter @stara/api typecheck",
    "test:unit": "pnpm -r test:unit",
    "test:integration": "pnpm -r --filter @stara/web --filter @stara/api --filter @stara/tooling test:integration",
    "test:coverage": "pnpm -r test:coverage",
    "test:mutation": "stryker run tooling/tests/stryker.config.mjs",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts --grep-invert @accessibility",
    "test:a11y": "playwright test --config tests/e2e/playwright.config.ts --grep @accessibility",
    "browsers:install": "playwright install",
    "build": "pnpm --filter @stara/web build && pnpm --filter @stara/api build && node tooling/scripts/workspace.mjs artifact",
    "validate": "pnpm tokens:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm security:secrets && pnpm test:coverage && pnpm build && pnpm test:e2e && pnpm test:a11y",
    "security:secrets": "secretlint \"**/*\"",
    "security:codeql": "node tooling/scripts/codeql.mjs",
    "security:dependencies": "pnpm audit --audit-level high",
    "tokens:update": "node tooling/scripts/workspace.mjs tokens-update",
    "tokens:check": "node tooling/scripts/workspace.mjs tokens-check",
    "hooks:install": "node tooling/scripts/workspace.mjs hooks-install",
    "check:commit": "node tooling/scripts/workspace.mjs commit",
    "check:push": "node tooling/scripts/workspace.mjs push",
    "check:pr": "node tooling/scripts/workspace.mjs pr",
    "release:images": "node tooling/release/cli.mjs images",
    "release:safety": "node tooling/release/cli.mjs safety",
    "release:await-checks": "node tooling/release/cli.mjs await-checks",
    "release:publish": "node tooling/release/cli.mjs publish",
    "release:dispatch": "node tooling/release/cli.mjs dispatch",
    "release:coverage": "node tooling/release/cli.mjs coverage-export"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.5",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "secretlint": "13.0.5",
    "simple-git-hooks": "2.14.0",
    "style-dictionary": "5.5.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "yaml": "2.9.0"
  },
  "prettier": "./tooling/config/prettier.mjs",
  "simple-git-hooks": {
    "pre-commit": "pnpm check:commit",
    "commit-msg": "pnpm exec commitlint --edit \"$1\"",
    "pre-push": "pnpm check:push --hook"
  }
}
